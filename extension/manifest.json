{
  "manifest_version": 3,
  "name": "Pantry – capture des commandes",
  "version": "0.6.1",
  "description": "Lit les commandes et les prix affichés sur Walmart.ca et Maxi.ca et les exporte pour l'app Pantry.",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["https://www.walmart.ca/*", "https://www.maxi.ca/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.walmart.ca/*", "https://www.maxi.ca/*"],
      "exclude_matches": ["https://www.maxi.ca/", "https://www.maxi.ca/?*", "https://www.maxi.ca/en", "https://www.maxi.ca/en?*", "https://www.maxi.ca/en/", "https://www.maxi.ca/en/?*", "https://www.maxi.ca/fr", "https://www.maxi.ca/fr?*", "https://www.maxi.ca/fr/", "https://www.maxi.ca/fr/?*"],
      "js": ["parsers.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gitofrequirement.github.io/ListMaker/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Pantry", "default_icon": "icon.png" },
  "icons": { "128": "icon.png" }
}
